def bubble_sort(arr):
    n = len(arr)

    for i in range(n):
        swapped = False

        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                # Swap the elements
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True

        if not swapped:
            break

    return arr


if __name__ == "__main__":
    input_list = input("Enter a list of numbers (space-separated): ").strip().split()
    arr = [int(num) for num in input_list]

    print("Original array:", arr)

    bubble_sort(arr)

    print("Sorted array:", arr)
